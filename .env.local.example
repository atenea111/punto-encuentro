# Web Client ID de Google (tipo Web, NO Android).
# Firebase Console → Authentication → Sign-in method → Google → Web SDK configuration
# O ejecutar: node scripts/show-google-web-client-id.js
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Cliente OAuth tipo iOS, del mismo proyecto Firebase y bundle ID com.encuentro12.
# GoogleService-Info.plist → CLIENT_ID. Se incorpora al JavaScript al compilar.
NEXT_PUBLIC_GOOGLE_IOS_CLIENT_ID=
